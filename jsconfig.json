{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@services/*": ["services/*"],
      "@utils/*": ["utils/*"],
      "@hooks/*": ["hooks/*"],
      "@assets/*": ["assets/*"],
      "@styles/*": ["styles/*"],
      "@store/*": ["store/*"],
      "@routes/*": ["routes/*"],
      "@context/*": ["context/*"]
    },
    "target": "es6",
    "module": "commonjs",
    "jsx": "react",
    "checkJs": false,
    "allowJs": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist"]
}
